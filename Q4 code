
import time

# Method 1: Repeated +=
def build_plus(parts):
    text = ""
    for p in parts:
        text += p + ";"
    return text


# Method 2: Using join()
def build_join(parts):
    return ";".join(parts) + ";"


# Method 3: Using f-string for each line
def build_fstring(parts):
    return "".join(f"{p};" for p in parts)


# Benchmark function
def measure(function, items):
    total_time = 0

    for run in range(3):
        start = time.perf_counter()
        result = function(items)
        end = time.perf_counter()

        total_time += end - start

    return total_time / 3, result


# Test different input sizes
sizes = [1000, 10000, 200000]

print("STRING BUILDING PERFORMANCE COMPARISON")
print("---------------------------------------")

for size in sizes:
    items = [f"Item{i}:Rs{i % 50}" for i in range(size)]

    plus_time, a = measure(build_plus, items)
    join_time, b = measure(build_join, items)
    fstring_time, c = measure(build_fstring, items)

    print("\nNumber of lines:", size)
    print("Same text:", a == b == c)
    print("Length:", len(a))
    print(f"+= Average time: {plus_time:.6f} seconds")
    print(f"join Average time: {join_time:.6f} seconds")
    print(f"f-string Average time: {fstring_time:.6f} seconds")
