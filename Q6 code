
# Q6 - Recursion and Memoisation

from functools import lru_cache
import sys
import time

# Count function calls
calls = 0


# 1. Plain recursive function
def ways_naive(n):
    global calls
    calls += 1

    if n <= 1:
        return 1

    return ways_naive(n - 1) + ways_naive(n - 2)


# 2. Recursive function with memoisation
@lru_cache(maxsize=None)
def ways_memo(n):
    global calls
    calls += 1

    if n <= 1:
        return 1

    return ways_memo(n - 1) + ways_memo(n - 2)


print("1. CORRECTNESS CHECK")
print("--------------------")

for n in range(1, 7):
    print("Steps:", n, "Ways:", ways_memo(n))


print("\n2. NAIVE AND MEMOISED CALL COUNTS")
print("--------------------------------")

for n in [10, 20, 25, 30]:
    calls = 0
    naive_result = ways_naive(n)
    naive_calls = calls

    calls = 0
    ways_memo.cache_clear()
    memo_result = ways_memo(n)
    memo_calls = calls

    print("\nn =", n)
    print("Naive:", naive_result, "| Calls:", naive_calls)
    print("Memo :", memo_result, "| Calls:", memo_calls)


print("\n3. CALL TREE FOR n = 5")
print("----------------------")
print("ways(5)")
print("|-- ways(4)")
print("|   |-- ways(3)")
print("|   |   |-- ways(2)")
print("|   |   |-- ways(1)")
print("|   |-- ways(2)")
print("|-- ways(3)")
print("    |-- ways(2)")
print("    |-- ways(1)")
print("Repeated calls: ways(3), ways(2), ways(1)")


# 3. Iterative solution
def ways_loop(n):
    if n <= 1:
        return 1

    a, b = 1, 1

    for i in range(2, n + 1):
        a, b = b, a + b

    return b


print("\n4. RECURSION LIMIT")
print("------------------")
print("Current recursion limit:", sys.getrecursionlimit())

ways_memo.cache_clear()

try:
    print("Memoised ways for 1000 steps:", ways_memo(1000))
except RecursionError:
    print("RecursionError occurred at 1000 steps.")


print("\n5. ITERATIVE SOLUTION FOR 1000")
print("------------------------------")
print("Ways for 1000 steps:", ways_loop(1000))


print("\n6. PERFORMANCE COMPARISON")
print("-------------------------")

for n in [10, 20, 25, 30]:
    start = time.perf_counter()
    ways_naive(n)
    naive_time = time.perf_counter() - start

    ways_memo.cache_clear()
    start = time.perf_counter()
    ways_memo(n)
    memo_time = time.perf_counter() - start

    start = time.perf_counter()
    ways_loop(n)
    loop_time = time.perf_counter() - start

    print("\nn =", n)
    print("Naive time:", round(naive_time, 6), "seconds")
    print("Memo time :", round(memo_time, 6), "seconds")
    print("Loop time :", round(loop_time, 6), "seconds")
