
# Q7 - Diagnose, Redesign and Validate
# Original: Plain Recursion
# Redesigned: Iterative Solution

import time

# ORIGINAL SOLUTION
naive_calls = 0

def ways_naive(n):
    global naive_calls
    naive_calls += 1

    if n <= 1:
        return 1

    return ways_naive(n - 1) + ways_naive(n - 2)


# REDESIGNED SOLUTION
loop_iterations = 0

def ways_iterative(n):
    global loop_iterations
    loop_iterations = 0

    if n <= 1:
        return 1

    a, b = 1, 1

    for i in range(2, n + 1):
        a, b = b, a + b
        loop_iterations += 1

    return b


# COMPARE BOTH SOLUTIONS
print("Q7 - ORIGINAL VS REDESIGNED SOLUTION")
print("------------------------------------")

for n in [10, 20, 25, 30]:

    naive_calls = 0
    start = time.perf_counter()
    original_result = ways_naive(n)
    original_time = time.perf_counter() - start
    original_calls = naive_calls

    start = time.perf_counter()
    redesigned_result = ways_iterative(n)
    redesigned_time = time.perf_counter() - start
    redesigned_iterations = loop_iterations

    print("\nNumber of steps:", n)
    print("Original result:", original_result)
    print("Redesigned result:", redesigned_result)
    print("Results match:", original_result == redesigned_result)

    print("Original function calls:", original_calls)
    print("Redesigned loop iterations:", redesigned_iterations)

    print("Original time:", round(original_time, 6), "seconds")
    print("Redesigned time:", round(redesigned_time, 6), "seconds")


# TEST WITH 1000 STEPS
print("\n1000-STEP VALIDATION")
print("--------------------")

result = ways_iterative(1000)

print("Number of steps: 1000")
print("Number of digits in result:", len(str(result)))

print("Loop iterations:", loop_iterations)
print("Successfully calculated using iteration.")
