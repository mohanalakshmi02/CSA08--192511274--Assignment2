# Q1 - Electricity Subsidy Eligibility

households = [
    ("H1", 80, False, False),
    ("H2", 100, True, False),
    ("H3", 101, True, False),
    ("H4", 101, False, False),
    ("H5", 150, True, False),
    ("H6", 200, False, False),
    ("H7", 201, False, False),
    ("H8", 250, False, True)
]


# Method 1: Separate if statements
def separate_if(units, ration_card, senior):
    results = []

    if units <= 100:
        results.append("Full subsidy")

    if units <= 200 and ration_card:
        results.append("Partial subsidy")

    if units > 200 and senior:
        results.append("Senior citizen subsidy")

    if units > 200 and not senior:
        results.append("No subsidy")

    if not results:
        results.append("No subsidy")

    return " + ".join(results)


# Method 2: if-elif-else
def elif_decision(units, ration_card, senior):
    if units <= 100:
        return "Full subsidy"
    elif 101 <= units <= 200 and ration_card:
        return "Partial subsidy"
    elif units > 200 and senior:
        return "Senior citizen subsidy"
    else:
        return "No subsidy"


# Method 3: match-case alternative
def match_decision(units, ration_card, senior):
    match units:
        case n if n <= 100:
            return "Full subsidy"
        case n if 101 <= n <= 200 and ration_card:
            return "Partial subsidy"
        case n if n > 200 and senior:
            return "Senior citizen subsidy"
        case _:
            return "No subsidy"


print("ELECTRICITY SUBSIDY ELIGIBILITY")
print("-----------------------------------------------")

for name, units, ration, senior in households:
    result1 = separate_if(units, ration, senior)
    result2 = elif_decision(units, ration, senior)
    result3 = match_decision(units, ration, senior)

    print(f"\n{name} - Units: {units}")
    print("Separate if :", result1)
    print("if-elif-else:", result2)
    print("match-case  :", result3)
